# The Internet Ship: environment variables
#
# Copy to .env.local and fill in. Never commit real values.
# `npm run secrets:generate` adds CODE_PEPPER and CODE_ENCRYPTION_KEY for you.

# Supabase project API URL (Dashboard → Project Settings → Data API).
# Project "internet-ship" (ap-south-1): https://azdwcmtezytrvoccnhao.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Secret key, server only: it bypasses RLS. Dashboard → Project Settings → API Keys →
# "Secret keys" (sb_secret_...). The legacy service_role key also works.
# Never expose it to the browser (no NEXT_PUBLIC_ prefix), never log it.
SUPABASE_SECRET_KEY=

# HMAC key (base64, >= 32 bytes) for boarding-code hashes and hashed IP rate-limit keys.
# Changing it makes every unredeemed code invalid.
CODE_PEPPER=

# AES-256-GCM key (base64, exactly 32 bytes) for the encrypted copy of an unredeemed code,
# kept so a retried DM can re-send the same code (Milestone 3). Changing it breaks re-sends.
CODE_ENCRYPTION_KEY=

# Shared with OpenReply to sign /internal/* requests (base64, >= 32 bytes). Same value in
# OpenReply's SHIP_INTERNAL_SECRET. Without it, /internal/* rejects everything.
SHIP_INTERNAL_SECRET=

# Public origin of this site; boarding DMs link to <SHIP_PUBLIC_URL>/board.
SHIP_PUBLIC_URL=https://ship.example.com

# Optional. The header that carries the real client IP for rate limiting. Leave unset on Vercel
# (uses x-real-ip, which Vercel sets). Behind Cloudflare use cf-connecting-ip. Never pick a
# header your host doesn't overwrite, or clients can fake their IP.
# CLIENT_IP_HEADER=

# Optional. Which ship this deployment serves (default: main). Tests use throwaway test_* ships.
# SHIP_ID=main

# Tests only (public by design): proves anonymous callers can't read tables or call functions.
SUPABASE_PUBLISHABLE_KEY=
