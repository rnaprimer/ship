{
  "name": "internet-ship",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:assets": "node scripts/build-ship-assets.ts",
    "start:lan": "next start --hostname 0.0.0.0",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-supabase.ts",
    "secrets:generate": "node scripts/generate-secrets.ts",
    "invite:mint": "node --env-file-if-exists=.env.local scripts/mint-codes.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "jose": "^6.2.18",
    "next": "16.4.6",
    "phaser": "^4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "type": "module"
}
